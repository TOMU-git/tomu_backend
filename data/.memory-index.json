      "text": "وَأَكْثَرُهَا فِي شِمَالِ إِفْرِيقِيَا وَآسِيَا.",
      "translationUz": "ularning aksariyati Shimoliy Afrika va Osiyoda.",
      "audioUrl": null,
      "title": "اَللُّغَةُ  الْعَرَبِيَّةُ"
    },
    {
      "id": "ar_m1_l31_t1",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 31,
      "turnIndex": 1,
      "speaker": null,
      "text": "هَذِهِ غَابَةٌ، وَهِيَ كَبِيرَةٌ وَ وَاسِعَةٌ جِدًّا.",
      "translationUz": "Bu o'rmon va u juda katta va keng.",
      "audioUrl": null,
      "title": "اَلْغَابَةُ الكَبِيْرَةُ"
    },
    {
      "id": "ar_m1_l31_t2",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 31,
      "turnIndex": 2,
      "speaker": null,
      "text": "فِي الْغَابَةِ أَشْجَارٌ، وَ أَزْهَارٌ، وَ حَيَوَانَاتٌ مُخْتَلِفَةٌ.",
      "translationUz": "O'rmonda daraxtlar, gullar va turli hayvonlar bor.",
      "audioUrl": null,
      "title": "اَلْغَابَةُ الكَبِيْرَةُ"
    },
    {
      "id": "ar_m1_l31_t3",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 31,
      "turnIndex": 3,
      "speaker": null,
      "text": "مِنَ الْحَيَوَانَاتِ مِثَالًا: أَسَدٌ، وَ ثَعْلَبٌ، وَ ذِئْبٌ، وَ فِيلٌ، وَ زَرَافَةٌ، وَ غَيْرُ ذَلِكَ.",
      "translationUz": "Hayvonlardan masalan: sher, tulki, bo'ri, fil, jirafa va boshqalar.",
      "audioUrl": null,
      "title": "اَلْغَابَةُ الكَبِيْرَةُ"
    },
    {
      "id": "ar_m1_l31_t4",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 31,
      "turnIndex": 4,
      "speaker": null,
      "text": "الْغَابَةُ رَائِعَةٌ وَ مُدْهِشَةٌ جِدًّا.",
      "translationUz": "O'rmon juda ajoyib va hayratlanarlidir.",
      "audioUrl": null,
      "title": "اَلْغَابَةُ الكَبِيْرَةُ"
    },
    {
      "id": "ar_m1_l32_t1",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 32,
      "turnIndex": 1,
      "speaker": null,
      "text": "خَرَجَ مُحَمَّدٌ مِنَ الْبَيْتِ، وَ ذَهَبَ إِلَى الْمَحَطَّةِ، وَ رَكِبَ الْحَافِلَةَ.",
      "translationUz": "Muhammad uydan chiqdi, stansiyaga bordi va avtobusga chiqdi.",
      "audioUrl": null,
      "title": "سَائِقُ الْحَافِلَةِ"
    },
    {
      "id": "ar_m1_l32_t2",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 32,
      "turnIndex": 2,
      "speaker": null,
      "text": "سَاقَ السَّائِقُ الْحَافِلَةَ بِسُرْعَةٍ شَدِيدَةٍ، وَ وَصَلَ مُحَمَّدٌ إِلَى الْعَمَلِ مُبَكِّرًا.",
      "translationUz": "Haydovchi avtobusni juda tez haydadi va Muhammad ishga erta yetib keldi.",
      "audioUrl": null,
      "title": "سَائِقُ الْحَافِلَةِ"
    },
    {
      "id": "ar_m1_l33_t1",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 33,
      "turnIndex": 1,
      "speaker": null,
      "text": "بِنْتُ خَدِيجَةَ طِفْلَةٌ صَغِيرَةٌ.",
      "translationUz": "Xadichaning qizi kichik qiz bola.",
      "audioUrl": null,
      "title": "بِنْتُ خَدِيجَةَ"
    },
    {
      "id": "ar_m1_l33_t2",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 33,
      "turnIndex": 2,
      "speaker": null,
      "text": "هِيَ تَلْعَبُ فِي الْمَلْعَبِ كُلَّ يَوْمٍ.",
      "translationUz": "U har kuni maydonda o'ynaydi.",
      "audioUrl": null,
      "title": "بِنْتُ خَدِيجَةَ"
    },
    {
      "id": "ar_m1_l33_t3",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 33,
      "turnIndex": 3,
      "speaker": null,
      "text": "هِيَ ذَكِيَّةٌ وَجَمِيلَةٌ.",
      "translationUz": "U aqlli va chiroyli.",
      "audioUrl": null,
      "title": "بِنْتُ خَدِيجَةَ"
    },
    {
      "id": "ar_m1_l34_t1",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 34,
      "turnIndex": 1,
      "speaker": null,
      "text": "جَاءَ الْمُعَلِّمُ الْمَدْرَسَةَ، فَتَحَ بَابَ الْفَصْلِ، ثُمَّ دَخَلَهُ وَبَدَأَ الدَّرْسَ.",
      "translationUz": "O'qituvchi maktabga keldi, sinf eshigini ochdi, so'ng unga kirdi va darsni boshladi.",
      "audioUrl": null,
      "title": "تَأَخَّرَتْ خَدِيجَةُ"
    },
    {
      "id": "ar_m1_l34_t2",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 34,
      "turnIndex": 2,
      "speaker": null,
      "text": "جَاءَتْ خَدِيجَةُ بَعْدَ الْمُعَلِّمِ، وَ قَدْ تَأَخَّرَتْ.",
      "translationUz": "Xadicha o'qituvchidan keyin keldi va u kech qolgan edi.",
      "audioUrl": null,
      "title": "تَأَخَّرَتْ خَدِيجَةُ"
    },
    {
      "id": "ar_m1_l35_t1",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 35,
      "turnIndex": 1,
      "speaker": "اَلْأَبُ",
      "text": "يَا بُنَيَّ، عِندِي عَشَرَةُ كُتُبٍ. أَخَذَتْ أُخْتُكَ ثَلَاثَةَ كُتُبٍ. فَكَمْ بَقِيَ لَدَيَّ، يَا بُنَيُّ؟",
      "translationUz": "Ey o'g'lim, menda o'nta kitob bor. Opang uchta kitob oldi. Qancha qoldi, o'g'lim?",
      "audioUrl": null,
      "title": "اَلْأَبُ وَ مَحْمُودٌ"
    },
    {
      "id": "ar_m1_l35_t2",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 35,
      "turnIndex": 2,
      "speaker": "مَحْمُودٌ",
      "text": "عَشَرَةُ كُتُبٍ.",
      "translationUz": "O'n kitob.",
      "audioUrl": null,
      "title": "اَلْأَبُ وَ مَحْمُودٌ"
    },
    {
      "id": "ar_m1_l35_t3",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 35,
      "turnIndex": 3,
      "speaker": "اَلْأَبُ",
      "text": "لِمَاذَا قُلْتَ عَشَرَةً؟",
      "translationUz": "Nega o'n deding?",
      "audioUrl": null,
      "title": "اَلْأَبُ وَ مَحْمُودٌ"
    },
    {
      "id": "ar_m1_l35_t4",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 35,
      "turnIndex": 4,
      "speaker": "مُحَمَّدٌ",
      "text": "بَقِيَتْ عِنْدَكَ سَبْعَةُ كُتُبٍ، وَ ثَلَاثَةُ كُتُبٍ فِي الْخِزَانَةِ.",
      "translationUz": "Sizda ettita kitob qoldi, va uchtasi shkafda.",
      "audioUrl": null,
      "title": "اَلْأَبُ وَ مَحْمُودٌ"
    },
    {
      "id": "ar_m1_l36_t1",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 36,
      "turnIndex": 1,
      "speaker": "اَلْقِطّ",
      "text": "أَهْلًا، أَيُّهَا الفَأْرُ! إِلَى أَيْنَ تَذْهَبُ؟",
