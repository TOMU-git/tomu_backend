      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 36,
      "turnIndex": 3,
      "speaker": "اَلْقِطُّ",
      "text": "هَلْ أُسَاعِدُكَ؟",
      "translationUz": "Senga yordam beraymanmi?",
      "audioUrl": null,
      "title": "صَدَاقَةٌ غَيْرُ مُتَوَقَّعَةٍ"
