      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 39,
      "turnIndex": 2,
      "speaker": null,
      "text": "جَلَسُوا عِنْدَ الْنَهْرِ، وَ طَبَخُوا اللَّحْمَ.",
      "translationUz": "Ular daryo bo'yida o'tirdilar va go'sht pishirdilar.",
