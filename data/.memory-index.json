      "speaker": "Speaker2",
      "text": "لِي وَ لِأَخِي غُرْفَةٌ صَغِيرَةٌ.",
      "translationUz": "Menga va akamga kichik xona bor.",
      "audioUrl": null,
      "title": "عَائِلَتُنَا"
    },
