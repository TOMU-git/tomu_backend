      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 36,
      "turnIndex": 7,
      "speaker": "اَلْقِطٌّ",
      "text": "نَعَم، نَحْنُ أَصْدِقَاءُ!",
      "translationUz": "Ha, biz do'stmiz!",
      "audioUrl": null,
      "title": "صَدَاقَةٌ غَيْرُ مُتَوَقَّعَةٍ"
    },
    {
      "id": "ar_m1_l37_t1",
      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 37,
