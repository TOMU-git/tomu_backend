      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 37,
      "turnIndex": 2,
      "speaker": "Speaker2",
      "text": "نَعَمْ، عِنْدِي عَائِلَةٌ وَ عَائِلَتِي كَبِيرَةٌ.",
      "translationUz": "Ha, oilam bor va oilam katta.",
