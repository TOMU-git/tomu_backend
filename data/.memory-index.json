      "moduleNumber": 1,
      "lessonOrder": 36,
      "turnIndex": 4,
      "speaker": "اَلْفَأْرُ",
      "text": "شُكْرًا، وَلَكِنْ لَا تَأْكُلْنِي!",
      "translationUz": "Rahmat, lekin meni yema!",
      "audioUrl": null,
      "title": "صَدَاقَةٌ غَيْرُ مُتَوَقَّعَةٍ"
