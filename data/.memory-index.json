      "moduleNumber": 1,
      "lessonOrder": 36,
      "turnIndex": 6,
      "speaker": "اَلْفَأْرُ",
      "text": "رَائِع! إِذًا نَكُونُ أَصْدِقَاءَ؟",
      "translationUz": "Ajoyib! Unda do'st bo'lamizmi?",
      "audioUrl": null,
      "title": "صَدَاقَةٌ غَيْرُ مُتَوَقَّعَةٍ"
