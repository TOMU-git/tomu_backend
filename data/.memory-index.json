      "language": "ar",
      "moduleNumber": 1,
      "lessonOrder": 36,
      "turnIndex": 2,
      "speaker": "اَلْفَأْرُ",
      "text": "أَنَا أَبْحَثُ عَنْ جُبْنٍ لِلْغَدَاءِ.",
      "translationUz": "Men tushlik uchun pishloq qidiryapman.",
