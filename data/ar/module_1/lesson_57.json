        "audioUrl": null
      },
      {
        "turnIndex": 2,
        "speaker": "جَمَالٌ",
        "text": "وَعَلَيْكُمُ السَّلَامُ.",
        "translationUz": "Va alaykum assalom.",
        "audioUrl": null
      },
      {
        "turnIndex": 3,
        "speaker": "نَادِرٌ",
        "text": "مَا اسْمُكَ يَا أَخِي؟",
        "translationUz": "Isming nima, aka?",
        "audioUrl": null
      },
      {
        "turnIndex": 4,
        "speaker": "جَمَالٌ",
        "text": "إِسْمِي جَمَالٌ، وَمَا اسْمُكَ يَا أَخِي العَزِيزُ؟",
        "translationUz": "Mening ismim Jamol, sening isming nima, aziz akam?",
        "audioUrl": null
      },
      {
        "turnIndex": 5,
        "speaker": "نَادِرٌ",
        "text": "إِسْمِي نَادِرٌ.",
        "translationUz": "Mening ismim Nodir.",
        "audioUrl": null
      },
      {
        "turnIndex": 6,
        "speaker": "جَمَالٌ",
        "text": "مِنْ أَيِّ بَلَدٍ أَنْتَ؟",
        "translationUz": "Qaysi davlatdansan?",
        "audioUrl": null
      },
      {
        "turnIndex": 7,
        "speaker": "نَادِرٌ",
        "text": "أَنَا مِنْ أُوزْبَكِسْتَانَ، وَأَنْتَ؟",
        "translationUz": "Men O'zbekistondanman, senchi?",
        "audioUrl": null
      },
      {
        "turnIndex": 8,
        "speaker": "جَمَالٌ",
        "text": "أَنَا مِنْ مِصْرَ.",
        "translationUz": "Men Misrdanman.",
        "audioUrl": null
      },
      {
        "turnIndex": 9,
        "speaker": "نَادِرٌ",
        "text": "أَهْلًا وَسَهْلًا!",
