  "dialogue": [
    {
      "turnIndex": 1,
      "speaker": "عَلِيٌّ",
      "text": "هَلِ الْبِنْطَالُ جَدِيدٌ؟",
      "translationUz": "Shim yangimi?",
      "audioUrl": null
    },
    {
      "turnIndex": 2,
      "speaker": "مُحَمَّدٌ",
      "text": "نَعَمْ، يَا صَدِيقِي، إِشْتَرَيْتُهُ مِنْ مَحَلِّ الْمَلَابِسِ الَّذِي بِجِوَارِ جَامِعَتِنَا.",
      "translationUz": "Ha, do'stim, men uni universitetimiz yonidagi kiyim do'konidan sotib oldim.",
      "audioUrl": null
    },
    {
      "turnIndex": 3,
      "speaker": "عَلِيٌّ",
      "text": "بِكَمِ إِشْتَرَيْتَهُ؟ فَأَنَا أُرِيدُ مِثْلَهُ.",
      "translationUz": "Qancha pulga sotib olding? Chunki men ham xuddi shunday xohlayman.",
      "audioUrl": null
    },
    {
      "turnIndex": 4,
      "speaker": "مُحَمَّدٌ",
      "text": "سِعْرُهُ ثَمَانُونَ جُنَيْهًا.",
      "translationUz": "Uning narxi sakson fun.",
      "audioUrl": null
    }
