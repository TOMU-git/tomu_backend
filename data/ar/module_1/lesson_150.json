  "monologue": [
    {
      "segmentIndex": 1,
      "text": "كُنْتُ فِي الْمَدْرَسَةِ، فَسَأَلْتُ صَدِيقِي: “أَيُّهُمَا أَصْعَبُ، اللُّغَةُ الْعَرَبِيَّةُ أَمِ الْإِنْجِلِيزِيَّةُ؟”",
      "translationUz": "Men maktabda edim va do‘stimdan so‘radim: “Qaysi biri qiyinroq — arab tili yoki ingliz tili?”",
      "audioUrl": null
    },
    {
      "segmentIndex": 2,
      "text": "فَقَالَ لِي: “اَللُّغَةُ الْعَرَبِيَّةُ وَاللُّغَةُ الْإِنْجِلِيزِيَّةُ سَهْلَتَانِ إِذَا دَرَسْتَ بِجِدٍّ وَنَشَاطٍ”.",
      "translationUz": "U menga dedi: “Arab tili ham, ingliz tili ham oson, agar sen jiddiy va faol o‘qisang.”",
      "audioUrl": null
    }
  ],
