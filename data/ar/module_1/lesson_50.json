    "dialogue": [
      {
        "turnIndex": 1,
        "speaker": "اَلْأُمُّ",
        "text": "أَيْنَ الْفِنْجَانُ الَّذِي عَلَى الطَّاوِلَةِ لِلْقَهْوَةِ؟",
        "translationUz": "Stoldagi qahva finjoni qayerda?",
