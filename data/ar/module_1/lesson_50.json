      },
      {
        "turnIndex": 2,
        "speaker": "سَلْمَى",
        "text": "الْفِنْجَانُ خَلْفَ الْفُرْنِ.",
        "translationUz": "Finjon pechning orqasida.",
        "audioUrl": null
      },
      {
        "turnIndex": 3,
        "speaker": "الأُمُّ",
        "text": "وَ أَيْنَ الْقَهْوَةُ الَّتِي اشْتَرَيْتُهَا أَمْسِ؟",
        "translationUz": "Kecha sotib olgan qahvam qayerda?",
