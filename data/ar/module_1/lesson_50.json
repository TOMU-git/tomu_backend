      {
        "turnIndex": 4,
        "speaker": "سَلْمَى",
        "text": "الْقَهْوَةُ فِي الْفُرْنِ.",
        "translationUz": "Qahva pechda.",
        "audioUrl": null
      },
      {
        "turnIndex": 5,
        "speaker": "الأُمُّ",
        "text": "يَا سَلْمَى، هُنَاكَ عُلْبَةٌ خَاصَّةٌ لِلْقَهْوَةِ.",
        "translationUz": "Ey Salmo, u yerda qahva uchun maxsus quti bor.",
