  "dialogue": [
    {
      "turnIndex": 1,
      "speaker": "اَلْوَلَدُ",
      "text": "مَاذَا تَطْبُخِينَ الْيَوْمَ يَا أُمِّي؟",
      "translationUz": "Bugun nima pishirayapsiz, onajon?",
      "audioUrl": null
