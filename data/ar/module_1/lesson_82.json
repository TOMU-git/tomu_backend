    "dialogue": [
      {
        "turnIndex": 1,
        "speaker": "عَلِيٌّ",
        "text": "كَمْ أَخًا لَكَ يَا سَعِيدُ؟",
        "translationUz": "Necha akang bor, ey Said?",
        "audioUrl": null
      },
      {
        "turnIndex": 2,
        "speaker": "سَعِيدٌ",
        "text": "لِي ثَلَاثَةُ إِخْوَةٍ.",
        "translationUz": "Mening uchta akam bor.",
        "audioUrl": null
      },
      {
        "turnIndex": 3,
        "speaker": "عَلِيٌّ",
        "text": "وَ كَمْ أُخْتًا لَكَ يَا سَعِيدُ؟",
        "translationUz": "Va necha opang bor, ey Said?",
        "audioUrl": null
      },
      {
        "turnIndex": 4,
        "speaker": "سَعِيدٌ",
        "text": "لِي أُخْتٌ وَاحِدَةٌ.",
        "translationUz": "Mening bitta opam bor.",
        "audioUrl": null
      },
      {
        "turnIndex": 5,
        "speaker": "عَلِيٌّ",
        "text": "هَلْ يَدْرُسُونَ فِي الْمَدْرَسَةِ؟",
        "translationUz": "Ular maktabda o'qiydilarmi?",
        "audioUrl": null
      },
      {
        "turnIndex": 6,
        "speaker": "سَعِيدٌ",
        "text": "نَعَم، هُمْ يَدْرُسُونَ فِي الْمَدْرَسَةِ.",
        "translationUz": "Ha, ular maktabda o'qiydilar.",
        "audioUrl": null
      }
