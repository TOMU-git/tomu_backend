    {
      "turnIndex": 1,
      "speaker": "لَيْلَى",
      "text": "هَلْ تُحِبِّينَ الفَوَاكِهَ يَا سَلْمَى؟",
      "translationUz": "Mevalarni yoqtirasizmi, ey Salmo?",
      "audioUrl": null
    },
    {
      "turnIndex": 2,
      "speaker": "سَلْمَى",
      "text": "نَعَمْ، أُحِبُّ التِّينَ وَ المَوْزَ وَ البُرْتُقَالَ وَ التُّفَّاحَ وَ التُّوتَ.",
      "translationUz": "Ha, men anjir, banan, apelsin, olma va tutni yaxshi ko'raman.",
      "audioUrl": null
    },
    {
      "turnIndex": 3,
      "speaker": "لَيْلَى",
      "text": "رَائِعٌ، أَنَا أَيْضًا أُحِبُّ الفَوَاكِهَ الَّتِي تُحِبِّينَهَا.",
      "translationUz": "Ajoyib, men ham siz yoqtirgan mevalarni yaxshi ko'raman.",
