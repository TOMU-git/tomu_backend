    "dialogue": [
      {
        "turnIndex": 1,
        "speaker": "اَلْقِطّ",
        "text": "أَهْلًا، أَيُّهَا الفَأْرُ! إِلَى أَيْنَ تَذْهَبُ؟",
        "translationUz": "Salom, ey sichqon! Qayerga borayapsan?",
        "audioUrl": null
      },
      {
        "turnIndex": 2,
        "speaker": "اَلْفَأْرُ",
        "text": "أَنَا أَبْحَثُ عَنْ جُبْنٍ لِلْغَدَاءِ.",
        "translationUz": "Men tushlik uchun pishloq qidiryapman.",
        "audioUrl": null
      },
      {
        "turnIndex": 3,
        "speaker": "اَلْقِطُّ",
        "text": "هَلْ أُسَاعِدُكَ؟",
        "translationUz": "Senga yordam beraymanmi?",
        "audioUrl": null
      },
      {
        "turnIndex": 4,
        "speaker": "اَلْفَأْرُ",
        "text": "شُكْرًا، وَلَكِنْ لَا تَأْكُلْنِي!",
        "translationUz": "Rahmat, lekin meni yema!",
        "audioUrl": null
      },
      {
        "turnIndex": 5,
        "speaker": "اَلْقِطٌّ",
        "text": "هَادِئٌ أَنَا، أُفَضِّلُ السَّمَكَ.",
        "translationUz": "Men tinchman, baliqni afzal ko'raman.",
        "audioUrl": null
      },
      {
        "turnIndex": 6,
        "speaker": "اَلْفَأْرُ",
        "text": "رَائِع! إِذًا نَكُونُ أَصْدِقَاءَ؟",
        "translationUz": "Ajoyib! Unda do'st bo'lamizmi?",
        "audioUrl": null
      },
      {
        "turnIndex": 7,
        "speaker": "اَلْقِطٌّ",
        "text": "نَعَم، نَحْنُ أَصْدِقَاءُ!",
        "translationUz": "Ha, biz do'stmiz!",
        "audioUrl": null
      }
    ],
